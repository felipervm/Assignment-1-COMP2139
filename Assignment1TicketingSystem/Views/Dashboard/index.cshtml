@model Assignment1TicketingSystem.Models.ViewModels.DashboardViewModel

<h2>Welcome, @Model.User.FullName</h2>

<div class="card p-3">
    <h4>Your Upcoming Tickets</h4>

    @if (!Model.UpcomingPurchases.Any())
    {
        <p>No upcoming purchases.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Total</th>
                    <th>Tickets</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.UpcomingPurchases)
                {
                    <tr>
                        <td>@p.PurchaseDate.ToShortDateString()</td>
                        <td>@p.TotalCost.ToString("C")</td>
                        <td>@p.TotalTickets</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
